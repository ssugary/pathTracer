<RT3>
    <!--- The Camera -->
    <lookat look_from="0 -90 30" look_at="0 0 0" vup="0 1 0" />
    <camera type="perspective" fovy="25" />
    <integrator type="blinn" depth="2" />
    <!-- <sampler type="ssampler" x_samples="3" y_samples="3" jitter="true" samples_per_pixel="16" /> -->
    <aggregator type="bvh" split_method="middle" max_prims_per_node="4" />
    
    <!-- <sampler type="stratified" x_samples="4" y_samples="4" dimensions="1" jitter="on" /> -->
    <filter type="gaussian" alpha="3" x_width="5" y_width="5" />

    <film type="image" w_res="900" h_res="450" filename="teapot_hires_P.png" img_type="png" gamma_corrected="false" />
    <include filename="scenes/scene4/teapot_geometry.xml" />


    <lookat look_from="0 0 30" look_at="0 0 0" vup="0 1 0" />
    <camera type="orthographic" screen_window="-40 40 -20 20" />
    <integrator type="blinn" depth="2" />

    <film type="image" w_res="900" h_res="450" filename="teapot_hires_O.png" img_type="png" gamma_corrected="false" />
    <include filename="scenes/scene4/teapot_geometry.xml" />


    <lookat look_from="-20 -20 30" look_at="0 0 0" vup="0 1 0" />
    <camera type="spherical" mapping="equirectangular" shutter_open="0.0" shutter_close="1.0" />
    <integrator type="blinn" depth="2" />

    <film type="image" w_res="900" h_res="450" filename="teapot_hires_S.png" img_type="png" gamma_corrected="false" />
    <include filename="scenes/scene4/teapot_geometry.xml" />

</RT3>
