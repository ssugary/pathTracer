<RT3>
    <lookat look_from="0 4.5 -15" look_at="0 0 1" vup="0 1 0" />
    <camera type="perspective" fovy="45" /> 
    <integrator type="path" depth="1" />
    <!-- <sampler type="ssampler" x_samples="4" y_samples="4" jitter="true" n_sampled_dimensions="16" /> -->
    <sampler type="pixel" samples_per_pixel="1" />
    <film type="image" w_res="1920" h_res="1200" filename="all_lights.png" img_type="png" gamma_corrected="true" />        

    <!-- Objects storage -->
    <aggregator type="bvh" max_prims_per_node="4" />    

    <!-- The Scene -->
    <world_begin/>

        <background type="interpolated" bl="0.690 0.839 0.686" tl="0.016 0.388 0.792" tr="0.016 0.388 0.792" br="0.690 0.839 0.686" />
        <!-- Lights -->
        <light_source type="ambient" I="0.1 0.1 0.1" S="0.5 0.5 0.5" />
        <light_source type="directional" I="0.9 0.9 0.9" S="0.4 0.4 0.4" from="1 0.8 -1" to="0 0 1" />
        <light_source type="point" I="0.95 0.9 0.8" S="0.4 0.4 0.4" from="0.1 3.0 1" />

        <!-- Material Library -->
        <make_named_material type="blinn_phong" name="gold"     ka="0.4 0.4 0.4" kd ="1 0.65 0.0"   ks ="0.8 0.6 0.2"  glossiness ="256"/>
        <make_named_material type="blinn_phong" name="grey"     ka="0.1 0.1 0.1" kd ="0.7 0.7 0.7"  ks ="0 0 0"        glossiness ="0"/>
        <make_named_material type="blinn_phong" name="redish"   ka="0.6 0.6 0.6" kd ="0.9 0.2 0.1"  ks ="0.8 0.8 0.8"  glossiness ="64"/>
        <make_named_material type="blinn_phong" name="greenish" ka="0.6 0.6 0.6" kd ="0.2 0.9 0.2"  ks ="0.8 0.8 0.8"  glossiness ="256"/>
        <make_named_material type="blinn_phong" name="blueish"  ka="0.6 0.6 0.6" kd ="0.1 0.2 0.9"  ks ="0.8 0.8 0.8"  glossiness ="16"/>
        <make_named_emitter  type="diffuse"     name="test"     s="1 1 1" i="1 1 1" />
        <!-- Objects -->
         <!-- <named_material name="redish"/>
        <object type="sphere" center="0 1 0" radius="1" /> -->
        
        <named_material name="grey"/>
        <object type="plane" point="0 0 0" normal="0 1 0" /> 

        <named_material name="greenish"/>
        <object type="sphere" center="-5 1 4" radius="1" />

        <named_material name="blueish"/>
        <object type="sphere" center="2 1 5" radius="1" />


        <named_material name="gold"/>
        <object type="sphere" center="5 3.1 -1" radius="1.3" />

        <!-- <named_emitter name="test"/> -->
        <push_CTM/>
            <rotate axis="1 0 0" angle="-90.0"/>
            <named_material name="redish"/>
            <object type="cylinder" center="0 2 0" radius="2" height="1" />                 
        <pop_CTM/>
        <!-- <emitter type="default"/> -->


    <world_end/>
</RT3>
