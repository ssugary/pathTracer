<RT3>
 
    <lookat look_from="-2 3.2 -11" look_at="0 1.3 1" vup="0 1 0" />
    <camera type="perspective" fovy="42" />
 
    <integrator type="path" depth="8" />
    <sampler type="halton" samples_per_pixel="256" />
    <filter type="gaussian" alpha="2" x_width="3" y_width="3" />
    <film type="image" w_res="1920" h_res="1200" filename="pbr_showcase.png" img_type="png" gamma_corrected="true" />
 
    <aggregator type="bvh" max_prims_per_node="4" />
 
    <world_begin/>
 
        <background type="interpolated"
            bl="0.86 0.90 0.94" tl="0.20 0.42 0.72"
            tr="0.20 0.42 0.72" br="0.86 0.90 0.94" />
 
        <!-- ===================== Luzes ===================== -->
        <!-- Ambiente bem baixo, só para preencher sombras puras -->
        <light_source type="ambient" I="0.04 0.045 0.05" s="0.3 0.3 0.3" />
 
        <!-- "Sol" direcional, luz principal da cena -->
        <light_source type="directional" I="1.0 0.96 0.88" s="0.85 0.85 0.85"
            from="0.5 1.0 -0.6" to="0 0 1" world_radius="60" />
 
        <!-- Point light fria de preenchimento, do lado oposto ao sol -->
        <light_source type="point" I="0.35 0.45 0.6" s="0.5 0.5 0.5"
            from="-6 4.5 -2" attenuation="1 0.02 0.005" />
 
        <!-- Spot dourado destacando a esfera de ouro -->
        <light_source type="spot" I="1.0 0.75 0.35" s="0.9 0.9 0.9"
            from="6 6 -3" to="4.2 1.4 -1" cutoff="22" falloff="10" />
 
        <!-- ===================== Biblioteca de materiais ===================== -->
 
        <!-- Chão xadrez-like em cinza neutro, difuso com leve brilho -->
        <make_named_texture name="teste_texture" type="constant" mapping="constant" data_type="color" value="1" />

        <make_named_texture name="vermelhao" type="bilerp" mapping="spherical" data_type="color" bl="255 0 0" br="255 0 0" tr="0 0 255" tl="0 0 255"/>
        
        <make_named_material type="blinn" name="ground"
            ka="0.05 0.05 0.05" kd="0.55 0.55 0.58" ks="0.10 0.10 0.10" glossiness="8" normal_map="vermelhao"/>
 
        <!-- Espelho perfeito (Blinn-Phong com mirror puro) -->
        <make_named_material type="blinn" name="mirror"
            ka="0.0 0.0 0.0" kd="0 0 0" ks="0 0 0" glossiness="0"
            mirror="0.95 0.95 0.95" />
 
        <!-- Vidro: PBR dielétrico, baixa rugosidade, IOR de vidro comum -->
        <make_named_material type="pbr" name="glass"
            kd="0.02 0.02 0.03" roughness="0.02" ior="1.5" mat_type="dielectric" />
 
        <!-- Vidro fosco: mesma família, mas mais rugoso -->
        <make_named_material type="pbr" name="frosted_glass"
            kd="0.05 0.05 0.06" roughness="0.25" ior="1.45" mat_type="dielectric" />
 
        <!-- Ouro: PBR condutor, eta/k reais de ouro (valores tabelados aprox.) -->
        <make_named_material type="pbr" name="gold_pbr"
            eta="0.143 0.375 1.442" k="3.983 2.386 1.603"
            roughness="0.12" mat_type="conductor" normal_map="vermelhao"/>
 
        <!-- Cobre: PBR condutor -->
        <make_named_material type="pbr" name="copper_pbr"
            eta="0.200 0.924 1.102" k="3.912 2.447 2.142"
            roughness="0.18" mat_type="conductor" />
 
        <!-- Alumínio escovado: condutor mais rugoso, tom neutro -->
        <make_named_material type="pbr" name="brushed_aluminum"
            eta="1.345 0.965 0.617" k="7.470 6.400 5.303"
            roughness="0.35" mat_type="conductor" />
 
        <!-- Cerâmica colorida difusa, para contraste com os metais/vidros -->
        <make_named_material type="blinn" name="ceramic_red"
            ka="0.05 0.02 0.02" kd="0.55 0.10 0.09" ks="0.25 0.25 0.25" glossiness="48" />
 
        <!-- Emissor de área para o "painel de luz" suspenso -->
        <make_named_emitter type="diffuse" name="softbox" s="1 1 1" i="6 6 5.5" two_sided="false" />
 
        <!-- ===================== Objetos ===================== -->
 
        <!-- Chão -->
        <named_material name="ground"/>
        <object type="plane" point="0 0 0" normal="0 1 0" />
 
        <!-- Esfera de vidro liso, ao centro -->
        <named_material name="glass"/>
        <object type="sphere" center="-1.6 1.15 0.5" radius="1.15" />
 
        <!-- Esfera de vidro fosco, um pouco atrás -->
        <named_material name="frosted_glass"/>
        <object type="sphere" center="-3.6 0.9 2.6" radius="0.9" />
 
        <!-- Esfera de ouro, iluminada pelo spot dourado -->
        <named_material name="gold_pbr"/>
        <object type="sphere" center="4.2 1.4 -1" radius="1.4" />
 
        <!-- Esfera de cobre -->
        <named_material name="copper_pbr"/>
        <object type="sphere" center="1.6 0.95 3.4" radius="0.95" />
 
        <!-- Esfera de alumínio escovado -->
        <!-- <named_material name="brushed_aluminum"/>
        <object type="sphere" center="0.2 0.8 -2.4" radius="0.8" />
 
        <!-- Esfera espelhada pura, para comparação com os condutores PBR -->
        <named_material name="mirror"/>
        <object type="sphere" center="3.0 0.75 5.6" radius="0.75" /> -->
 
        <!-- Pequeno cilindro cerâmico ao lado do vidro, para dar escala -->
        <!-- <push_ctm/>
            <translate delta="-1.6 0 -1.8" />
            <rotate axis="1 0 0" angle="-90.0" />
            <named_material name="ceramic_red"/>
            <object type="cylinder" center="0 0 0" radius="0.55" height="1.1" />
        <pop_ctm/>
 
        <push_ctm/>
            <translate delta="-2.2 6.5 1.0" />
            <rotate axis="1 0 0" angle="90.0" />
            <named_emitter name="softbox"/>
            <named_material name="ground"/>
            <object type="cylinder" center="0 0 0" radius="1.6" height="0.05" />
        <pop_ctm/>
        <emitter type="default"/> -->
 
    <world_end/>
</RT3>
 
